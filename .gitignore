*.pyc
*.bin
*.bak

# Diário de trade real (Excel, arquivo grande, dados pessoais de operações)
diario.xlsm

# Dados de mercado (CSV/Parquet) — reproduzíveis via run_backtest.py
data/

# Logs
log.txt
_log_*.txt
*.log
# Saída dos processos quando iniciados em background (nohup ... > _restart_*)
_restart_*.txt
# Scripts/arquivos de rascunho de diagnóstico, nunca parte do app
scratch_*.txt

# Configurações locais do Claude Code (permissões específicas da máquina)
.claude/settings.local.json

# Credenciais reais de contas de corretora (cTrader FIX, etc) — nunca versionar
